# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:5000/kite/callback

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Engine
QUANTNSE_MODE=demo
ENABLE_LIVE_ORDERS=false
WATCHLIST_SIZE=30
DUCKDB_PATH=data/quantnse.duckdb

# Optional Yahoo-backed pre-market macros
ENABLE_YAHOO_MACRO=true

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
